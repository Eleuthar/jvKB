    save(data) {
    }
}

class ExternalDB {
    save(data) {
    }
}

class LocalPersist {
    save(data) {
    }
}


# high level <<<<<<<<<<<<<<<<
class PersistMgr {
    saveData(db, data) {
        db.save(data);
    }
}



